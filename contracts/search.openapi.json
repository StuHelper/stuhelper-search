{
  "openapi": "3.0.3",
  "info": {
    "title": "StuHelper Search",
    "version": "0.4.0",
    "description": "提供按当前权限过滤的全站搜索、热门课程与教师排行及本人投票查询。"
  },
  "paths": {
    "/api/v1/search": {
      "get": {
        "operationId": "search",
        "summary": "按当前权限过滤的全站搜索",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "检索关键词，去除首尾空白后最长 200 个字符；省略或为空时按默认顺序浏览可见条目。",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "description": "限定检索的目标类型；省略时检索全部可见类型。",
            "schema": {
              "type": "string",
              "enum": [
                "school",
                "course",
                "teacher",
                "review",
                "resource"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "上一页响应返回的 next_cursor 续页游标；首次请求省略或传空字符串。",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "单页最多返回的可见条目数，默认 20，范围 1–100。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当前请求人可见的搜索结果分页。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "400": {
            "description": "请求参数、游标或分页上限不合法（invalid_input）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "请求未携带有效登录身份（unauthenticated）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "请求路径不存在（not_found）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "method_not_allowed",
            "headers": {
              "Allow": {
                "description": "允许的 HTTP 方法列表（GET）。",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "499": {
            "description": "cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "搜索索引正在初始化（index_building）或上游依赖暂不可用（unavailable）。",
            "headers": {
              "Retry-After": {
                "description": "建议客户端自动重试前等待的秒数。",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "查询或回源复核超时（timeout）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "学校 ID 与代码精确匹配，五位数字可匹配十位代码的后五位。名称、登记别名以及课程的英文名与曾用名支持字面子串匹配。搜索返回当前可见的规范目标。仅空 next_cursor 表示结束。"
      }
    },
    "/api/v1/search/popular": {
      "get": {
        "operationId": "popular",
        "summary": "配置窗口内活动加权排行，同分按来源和 ID 排序",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": true,
            "description": "热门榜单目标类型（课程或教师）。",
            "schema": {
              "type": "string",
              "enum": [
                "course",
                "teacher"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "上一页响应返回的 next_cursor 续页游标；首次请求省略或传空字符串。",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "单页最多返回的可见条目数，默认 20，范围 1–100。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "配置时间窗口内的热门目标分页及窗口天数。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "400": {
            "description": "榜单类型、游标或分页上限不合法（invalid_input）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "请求未携带有效登录身份（unauthenticated）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "请求路径不存在（not_found）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "method_not_allowed",
            "headers": {
              "Allow": {
                "description": "允许的 HTTP 方法列表（GET）。",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "499": {
            "description": "cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "搜索索引正在初始化（index_building）或活动来源暂不可用（unavailable）。",
            "headers": {
              "Retry-After": {
                "description": "建议客户端自动重试前等待的秒数。",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "热门汇总或回源复核超时（timeout）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "汇总配置热度窗口内各已启用来源的日活动指标并按后台权重排序，仅返回达到最低样本量且对当前请求人可见的目标。响应始终附带 window_days 供前端解释统计口径。仅当 next_cursor 为空字符串时表示分页结束。"
      }
    },
    "/api/v1/search/my-votes": {
      "get": {
        "operationId": "myVotes",
        "summary": "请求人当前有效投票，通过 reviews 公开接口读取",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "上一页响应返回的 next_cursor 续页游标；首次请求省略或传空字符串。",
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "单页最多返回的有效投票条数，默认 20，范围 1–100。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "请求人当前可见的有效投票分页。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Votes"
                }
              }
            }
          },
          "400": {
            "description": "游标或分页上限不合法（invalid_input）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "请求未携带有效登录身份（unauthenticated）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "请求路径不存在（not_found）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "method_not_allowed",
            "headers": {
              "Allow": {
                "description": "允许的 HTTP 方法列表（GET）。",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "499": {
            "description": "cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "评价来源暂不可用（unavailable）。",
            "headers": {
              "Retry-After": {
                "description": "建议客户端自动重试前等待的秒数。",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "投票查询或权限复核超时（timeout）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "读取请求人在 reviews 中的有效投票并逐条复核当前评价可见性。过滤不可见评价后单页 items 可能少于 limit，仅当 next_cursor 为空字符串时表示分页结束。"
      }
    }
  },
  "components": {
    "schemas": {
      "Target": {
        "type": "object",
        "additionalProperties": false,
        "description": "跨模块公开目标引用。",
        "properties": {
          "source": {
            "type": "string",
            "description": "拥有目标事实的业务模块。",
            "enum": [
              "catalog",
              "reviews",
              "resources"
            ]
          },
          "id": {
            "type": "string",
            "description": "目标在所属模块中的规范公开 ID。"
          },
          "kind": {
            "type": "string",
            "description": "目标业务对象类型。",
            "enum": [
              "school",
              "course",
              "teacher",
              "review",
              "resource"
            ]
          }
        },
        "required": [
          "source",
          "id",
          "kind"
        ]
      },
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "description": "经当前权限复核后的公开搜索或热门结果条目。",
        "properties": {
          "target": {
            "$ref": "#/components/schemas/Target"
          },
          "title": {
            "type": "string",
            "description": "目标公开标题或名称。"
          },
          "school_id": {
            "type": "string",
            "description": "目标所属学校 ID。"
          },
          "english_name": {
            "type": "string",
            "maxLength": 256,
            "description": "课程英文名。独立于 aliases；缺失时省略。"
          },
          "former_codes": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "已确认属于同一课程的曾用课程号，可搜索。"
          },
          "former_names": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "description": "课程曾用名，可搜索并在详情显示；不包含英文名或曾用课程号。"
          },
          "code": {
            "type": "string",
            "maxLength": 128,
            "description": "课程当前课程号或学校代码。"
          }
        },
        "required": [
          "target",
          "title",
          "school_id"
        ]
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "description": "本页通过权限复核的可见条目列表；过滤隐藏记录后长度可能小于 limit。",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "next_cursor": {
            "type": "string",
            "maxLength": 2048,
            "description": "下一页游标；仅当为空字符串时表示已到达末尾，非空时即使 items 为空仍可能存在后续页。"
          },
          "window_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 366,
            "description": "热门排行统计覆盖的配置时间窗口天数；仅热门接口返回，搜索接口省略。"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "description": "搜索或热门排行分页响应。"
      },
      "Vote": {
        "type": "object",
        "additionalProperties": false,
        "description": "请求人对单条课程评价的当前有效投票。",
        "properties": {
          "target": {
            "$ref": "#/components/schemas/Target"
          },
          "choice": {
            "type": "string",
            "description": "投票态度：up 为赞同，down 为反对。",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "target",
          "choice"
        ]
      },
      "Votes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "description": "本页当前可见的有效投票。过滤已撤回或无权限的目标后，条数可能少于 limit。",
            "items": {
              "$ref": "#/components/schemas/Vote"
            }
          },
          "next_cursor": {
            "type": "string",
            "maxLength": 1024,
            "description": "下一页游标；仅当为空字符串时表示分页结束。"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "description": "我的投票分页响应。"
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_input",
              "unauthenticated",
              "not_found",
              "method_not_allowed",
              "unavailable",
              "timeout",
              "cancelled",
              "index_building"
            ],
            "description": "稳定错误码，包含参数非法、未登录、路径或方法不支持、索引构建中、依赖不可用、超时及请求取消。"
          }
        },
        "required": [
          "code"
        ],
        "description": "稳定错误响应体，供客户端映射多语言文案与无障碍状态提示。"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
